{
  "name": "mcp-jira",
  "version": "1.0.6",
  "description": "",
  "main": "dist/loader.js",
  "scripts": {
    "start": "tsx src/loader.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:loader && npm run build:bundle",
    "build:loader": "esbuild src/loader.ts --platform=node --target=node18 --format=cjs --outfile=dist/loader.js",
    "build:bundle": "esbuild src/server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/bundle.js --minify",
    "dev": "tsx watch src/loader.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
